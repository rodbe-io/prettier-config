{
  "name": "@rodbe/prettier-config",
  "version": "1.6.0",
  "description": "RBX Prettier config",
  "keywords": [
    "front-end",
    "RBX",
    "typescript"
  ],
  "homepage": "https://github.com/rodbe-io/prettier-config",
  "bugs": {
    "url": "https://github.com/rodbe-io/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodbe-io/prettier-config.git"
  },
  "license": "MIT",
  "author": "KevinRodbe",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mid": {
      "import": "./dist/mid.js",
      "types": "./dist/mid.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm run type-check",
    "build": "pkgroll",
    "commit": "git-cz",
    "commitlint": "commitlint --edit",
    "prepare": "husky || true",
    "release": "semantic-release",
    "start": "pkgroll --watch",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@commitlint/format": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@eslint/js": "^9.17.0",
    "@eslint/json": "^0.14.0",
    "@rodbe/eslint-config": "^1.4.0",
    "@rodbe/tsconfig": "^1.5.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^0.85.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "nano-staged": "^0.9.0",
    "pkgroll": "^2.4.1",
    "prettier": "^3.7.4",
    "prettier-plugin-curly": "^0.4.1",
    "prettier-plugin-packagejson": "^2.5.20",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "prettier-plugin-curly": ">=0.3.1",
    "prettier-plugin-packagejson": ">=2.5.8"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">= 18.18.2",
    "npm": ">= 8.11.0",
    "pnpm": ">= 9.15.2"
  },
  "volta": {
    "node": "25.2.1",
    "pnpm": "10.5.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "enginesStrict": true
}
